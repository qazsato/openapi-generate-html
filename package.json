  "author": "qazsato <qazsato@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^13.0.5",
    "commander": "^12.1.0",
    "ejs": "^3.1.10",
    "fast-safe-stringify": "^2.1.1",
    "inquirer": "^12.0.0",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@stoplight/elements": "^9.0.28",
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "redoc": "^2.5.4",
    "swagger-ui-dist": "^5.33.2",
    "vitest": "^5.0.4"
