<!DOCTYPE html>
<html data-theme="<%= theme %>">
<head>
  <title><%= title %></title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0&icon_names=search" />
  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.26.2/swagger-ui.css" integrity="sha384-++DMKo1369T5pxDNqojF1F91bYxYiT1N7b1M15a7oCzEodfljztKlApQoH6eQSKI" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.9/dist/css/autoComplete.02.css" integrity="sha384-r5QN4qd43QzIH4XY1ZrNCPGXK0nprUu0OyvdUiCDtDblzY/Ioeb6VOF1AqhkJqAR" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.9/dist/autoComplete.min.js" integrity="sha384-HEl1rvUvVzi5Y7FoFIyjGkyj3xSPNa/z4tfWNu4rn0tMCV5EOgyv0z52rfigf0ns" crossorigin="anonymous"></script>
  <style><%- cssCommonContent %></style>
  <style><%- cssContent %></style>
  <script>window.apiDocs = <%- apiDocs %></script>
</head>
<body>
  <button id="search-button">
    <span class="icon material-symbols-outlined">search</span>
    <span class="text"></span>
  </button>
  <dialog id="search-dialog">
    <input id="auto-complete" autocomplete="off">
  </dialog>
  <div id="swagger-ui"></div>
  <script src="https://unpkg.com/swagger-ui-dist@5.26.2/swagger-ui-bundle.js" integrity="sha384-4VIVbbtAspop25+wp6W3cA3Mitj0/z1bCuDGEuBGnGlVudCFHrrCfGluiILJCIEd" crossorigin="anonymous"></script>
  <script><%- jsCommonContent %></script>
  <script><%- jsContent %></script>
</body>
</html>